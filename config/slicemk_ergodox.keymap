#define L_BASE_MAC 0
#define L_BASE_FORT 1
#define L_BASE_MINE 2
#define L_BASE_GAME 3
#define L_BASE_WIN 4
#define L_BASE_SKETCHUP 5
#define L_BASE_OLD 6
#define L_EXT_NAV 7
#define L_EXT_NUM 8
#define L_EXT_WIN_NAV 9
#define L_EXT_WIN_NUM 10
#define L_EXT_FUNC 11
#define L_MOUSE 12
#define L_LAYERS 13
#define L_UNDERGLOW 14
#define L_BLANK_TRANSPARENT 15

#define LEFT_KEYS 1 2 3 4 5 6 7 15 16 17 18 19 20 21 29 30 31 32 33 34 41 42 43 44 45 46 47 55 56 57 58 59
#define LEFT_THUMB_KEYS 65 66 69 70 71 75
#define RIGHT_KEYS 8 9 10 11 12 13 14 22 23 24 25 26 27 28 35 36 37 38 39 40 48 49 50 51 52 53 54 60 61 62 63 64
#define RIGHT_THUMB_KEYS 67 68 72 73 74 76

#define RGB_COLOR_MAGENTA RGB_COLOR_HSB(299, 87, 20)
#define RGB_COLOR_OFF RGB_COLOR_HSB(0, 100, 0)
#define RGB_COLOR_BLUE RGB_COLOR_HSB(240, 96, 20) 
#define RGB_COLOR_GREEN RGB_COLOR_HSB(127, 94, 20) 
#define RGB_COLOR_WHITE RGB_COLOR_HSB(0, 0, 20) 
#define RGB_COLOR_AMETHYST RGB_COLOR_HSB(150, 90, 20) // lighter green, not currently in use
#define RGB_COLOR_YELLOW RGB_COLOR_HSB(55, 100, 20) 
#define RGB_COLOR_RED RGB_COLOR_HSB(0, 100, 20)
#define RGB_COLOR_AZURE RGB_COLOR_HSB(180, 100, 20)
#define RGB_COLOR_ORANGE RGB_COLOR_HSB(30, 100, 20)
#define RGB_COLOR_PURPLE RGB_COLOR_HSB(270, 100, 20)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define HRM_TAP_TERM_MS 250
#define THUMB_TAP_TERM_MS 280
#define TAP_TERM_MS 200
#define QUICK_TAP_MS 160
#define PRIOR_IDLE_MS 150 // 167 is calibrated to 10500/63, where 63 is my casual WPM; 150 is calibrated to 10500/70 where 70 is my more regular typing speed

&mt {
    tapping-term-ms = <TAP_TERM_MS>;
    quick-tap-ms = <QUICK_TAP_MS>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <3000>;
    lazy;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_func {
            timeout-ms = <50>;
            key-positions = <69 74>;
            bindings = <&tog L_EXT_FUNC>;
            layers = <L_BASE_MAC L_BASE_WIN L_EXT_FUNC L_EXT_NAV L_EXT_NUM L_EXT_WIN_NAV L_EXT_WIN_NUM>;
        };
        combo_nav {
            timeout-ms = <50>;
            key-positions = <69 70>;
            bindings = <&tog L_EXT_NAV>;
            layers = <L_BASE_MAC L_EXT_NAV>;
        };
        combo_num {
            timeout-ms = <50>;
            key-positions = <73 74>;
            bindings = <&tog L_EXT_NUM>;
            layers = <L_BASE_MAC L_EXT_NUM>;
        };
        combo_win_nav {
            timeout-ms = <50>;
            key-positions = <69 70>;
            bindings = <&tog L_EXT_WIN_NAV>;
            layers = <L_BASE_WIN L_BASE_SKETCHUP L_EXT_WIN_NAV>;
        };
        combo_win_num {
            timeout-ms = <50>;
            key-positions = <73 74>;
            bindings = <&tog L_EXT_WIN_NUM>;
            layers = <L_BASE_WIN L_BASE_SKETCHUP L_EXT_WIN_NUM>;
        };
        combo_move_win {
          timeout-ms = <50>;
          key-positions = <16 17>;
          bindings = <&kp LC(LSHFT)>;
          layers = <L_BASE_MAC>;
        };
        combo_resize_win {
          timeout-ms = <50>;
          key-positions = <42 43>;
          bindings = <&kp LA(LSHFT)>;
          layers = <L_BASE_MAC>;
        };
        combo_clipboard_history {
          timeout-ms = <50>;
          key-positions = <45 46>;
          bindings = <&kp LG(LS(V))>;
          layers = <L_BASE_MAC>;
        };
        combo_reopen_tab {
          timeout-ms = <50>;
          key-positions = <20 21>;
          bindings = <&kp LG(LS(T))>;
          layers = <L_BASE_MAC>;
        };
        combo_win_reopen_tab {
          timeout-ms = <50>;
          key-positions = <20 21>;
          bindings = <&kp LC(LS(T))>;
          layers = <L_BASE_WIN>;
        };
        combo_fill_bitwarden {
          timeout-ms = <50>;
          key-positions = <38 39>;
          bindings = <&kp LG(LS(L))>;
          layers = <L_BASE_MAC>;
        };
        combo_tabs_list {
          timeout-ms = <50>;
          key-positions = <29 30>;
          bindings = <&kp LG(LS(A))>;
          layers = <L_BASE_MAC>;
        };
        combo_win_tabs_list {
          timeout-ms = <50>;
          key-positions = <29 30>;
          bindings = <&kp LC(LS(A))>;
          layers = <L_BASE_WIN L_BASE_SKETCHUP>;
        };
    };
};

/ {
  layer_listeners {
    compatible = "zmk,layer-listeners";

    underglow_nav {
      layers = <L_EXT_NAV>;
      bindings = <&rgb_ug RGB_COLOR_MAGENTA &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_win_nav {
      layers = <L_EXT_WIN_NAV>;
      bindings = <&rgb_ug RGB_COLOR_MAGENTA &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_num {
      layers = <L_EXT_NUM>;
      bindings = <&rgb_ug RGB_COLOR_BLUE &rgb_ug RGB_COLOR_OFF>;
    };	
    underglow_win_num {
      layers = <L_EXT_WIN_NUM>;
      bindings = <&rgb_ug RGB_COLOR_BLUE &rgb_ug RGB_COLOR_OFF>;
    };	
    underglow_func {
      layers = <L_EXT_FUNC>;
      bindings = <&rgb_ug RGB_COLOR_GREEN &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_fortnite {
      layers = <L_BASE_FORT>;
      bindings = <&rgb_ug RGB_COLOR_WHITE &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_minecraft {
      layers = <L_BASE_MINE>;
      bindings = <&rgb_ug RGB_COLOR_PURPLE &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_gaming {
      layers = <L_BASE_GAME>;
      bindings = <&rgb_ug RGB_COLOR_YELLOW &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_layers {
      layers = <L_LAYERS>;
      bindings = <&rgb_ug RGB_COLOR_RED &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_win {
      layers = <L_BASE_WIN>;
      bindings = <&rgb_ug RGB_COLOR_AZURE &rgb_ug RGB_COLOR_OFF>;
    };
    underglow_sketchup {
      layers = <L_BASE_SKETCHUP>;
      bindings = <&rgb_ug RGB_COLOR_ORANGE &rgb_ug RGB_COLOR_OFF>;
    };
  };
};


/ {
  behaviors {
    hrml: home_row_mod_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      require-prior-idle-ms = <PRIOR_IDLE_MS>;
      tapping-term-ms = <HRM_TAP_TERM_MS>;
      quick-tap-ms = <QUICK_TAP_MS>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <RIGHT_KEYS>; // List of keys on the right side of the keyboard
      hold-trigger-on-release;
    };
    hrmr: home_row_mod_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      require-prior-idle-ms = <PRIOR_IDLE_MS>;
      tapping-term-ms = <HRM_TAP_TERM_MS>;
      quick-tap-ms = <QUICK_TAP_MS>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <LEFT_KEYS>; // List of keys on the left side of the keyboard
      hold-trigger-on-release;
    };
	  tlt: thumb_layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      // require-prior-idle-ms = <PRIOR_IDLE_MS>;
      tapping-term-ms = <THUMB_TAP_TERM_MS>;
      quick-tap-ms = <QUICK_TAP_MS>;
      bindings = <&mo>, <&kp>;
	    display-name = "Thumb-Layer-Tap";
	  };
    tmt: thumb_mod_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      // require-prior-idle-ms = <PRIOR_IDLE_MS>;
      tapping-term-ms = <THUMB_TAP_TERM_MS>;
      quick-tap-ms = <QUICK_TAP_MS>;
      bindings = <&kp>, <&kp>;
	    display-name = "Thumb-Mod-Tap";
    };
    mt_rpt: modtap_repeat {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      // require-prior-idle-ms = <PRIOR_IDLE_MS>;
      tapping-term-ms = <THUMB_TAP_TERM_MS>;
      quick-tap-ms = <QUICK_TAP_MS>;
      bindings = <&kp>, <&key_repeat>;
	    display-name = "Mod-Tap-Repeat";
	  };
    skht: sticky_key_hold_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <TAP_TERM_MS>;
      bindings = <&kp>, <&sk>;
      display-name = "Sticky-Key-Hold-Tap";
    };
    leader: leader {
      compatible = "zmk,behavior-leader-key";
      #binding-cells = <0>;
      ignore-keys = <LSHFT RSHFT>;
      // leaves
      leaf_reopen_tab { sequence = <T>; bindings = <&kp LG(LS(T))>; };
      leaf_clipboard_history { sequence = <V>; bindings = <&kp LG(LS(V))>; };
      leaf_tabs_list { sequence = <A>; bindings = <&kp LG(LS(A))>; };

      // system (/)
      usb { sequence = <SLASH U>; bindings = <&out OUT_USB>; };
      sys_ble { sequence = <SLASH B>; bindings = <&out OUT_BLE>; };
      sys_bt0 { sequence = <SLASH N0>; bindings = <&bt BT_SEL 0>; };
      sys_bt1 { sequence = <SLASH N1>; bindings = <&bt BT_SEL 1>; };
      sys_bt2 { sequence = <SLASH N2>; bindings = <&bt BT_SEL 2>; };
      sys_bt3 { sequence = <SLASH N3>; bindings = <&bt BT_SEL 3>; };
      sys_bt4 { sequence = <SLASH N4>; bindings = <&bt BT_SEL 4>; };
      sys_btc { sequence = <SLASH C>; bindings = <&bt BT_CLR>; };

      // underglow (u)
      sys_ug_bri_inc { sequence = <U EQUAL>; bindings = <&rgb_ug RGB_BRI>; };
      sys_ug_bri_dec { sequence = <U MINUS>; bindings = <&rgb_ug RGB_BRD>; };
      sys_ug_off { sequence = <U X>; bindings = <&rgb_ug RGB_COLOR_HSB(0, 100, 0)>; };
      sys_ug_red { sequence = <U R>; bindings = <&rgb_ug RGB_COLOR_HSB(0, 100, 20)>; };
      sys_ug_white { sequence = <U W>; bindings = <&rgb_ug RGB_COLOR_HSB(0, 0, 20)> ; };
      sys_ug_blue { sequence = <U B>; bindings = <&rgb_ug RGB_COLOR_HSB(127, 94, 20)>; };

      // rectangle (r)
      rect_layout_work_obsidian { sequence = <R N1>; bindings = <&kp LG(LA(LC(LS(N1))))>; };
      rect_layout_work_obsidian2 { sequence = <R W O>; bindings = <&kp LG(LA(LC(LS(N1))))>; };
      rect_layout_work_meet { sequence = <R N2>; bindings = <&kp LG(LA(LC(LS(N2))))>; };
      rect_layout_work_meet2 { sequence = <R W M>; bindings = <&kp LG(LA(LC(LS(N2))))>; };
      rect_layout_work_code { sequence = <R N3>; bindings = <&kp LG(LA(LC(LS(N3))))>; };
      rect_layout_work_code2 { sequence = <R W C>; bindings = <&kp LG(LA(LC(LS(N3))))>; };
      rect_layout_home_obsidian { sequence = <R N6>; bindings = <&kp LG(LA(LC(LS(N6))))>; };
      rect_layout_home_obsidian2 { sequence = <R H O>; bindings = <&kp LG(LA(LC(LS(N6))))>; };
      rect_layout_home_meet { sequence = <R N7>; bindings = <&kp LG(LA(LC(LS(N7))))>; };
      rect_layout_home_meet2 { sequence = <R H M>; bindings = <&kp LG(LA(LC(LS(N7))))>; };
      rect_layout_home_code { sequence = <R N8>; bindings = <&kp LG(LA(LC(LS(N8))))>; };
      rect_layout_home_code2 { sequence = <R H C>; bindings = <&kp LG(LA(LC(LS(N8))))>; };
      rect_next_display { sequence = <R G>; bindings = <&kp LG(LA(LC(LS(RIGHT))))>; };
      rect_next_display2 { sequence = <R L>; bindings = <&kp LG(LA(LC(LS(RIGHT))))>; };
      rect_prev_display { sequence = <R P>; bindings = <&kp LG(LA(LC(LS(LEFT))))>; };
      rect_maximize { sequence = <R D>; bindings = <&kp LA(LC(RET))>; };
      rect_maximize2 { sequence = <R K>; bindings = <&kp LA(LC(RET))>; };
      rect_maximize3 { sequence = <R M>; bindings = <&kp LA(LC(RET))>; };
      rect_center { sequence = <R F>; bindings = <&kp LA(LC(C))>; };
      rect_center2 { sequence = <R J>; bindings = <&kp LA(LC(C))>; };
      rect_center3 { sequence = <R C>; bindings = <&kp LA(LC(C))>; };

      // desktop (d)
      desk_mission_ctrl { sequence = <D M>; bindings = <&kp LC(UP)>; };
      desk_mission_ctrl2 { sequence = <D D>; bindings = <&kp LC(UP)>; };
      desk_mission_ctrl3 { sequence = <D K>; bindings = <&kp LC(UP)>; };
      desk_fullscreen { sequence = <D F>; bindings = <&kp LG(LC(F))>; };
      desk_expose { sequence = <D E>; bindings = <&kp LC(DOWN)>; };
      desk_next { sequence = <D N>; bindings = <&kp LC(RIGHT)>; };
      desk_next2 { sequence = <D G>; bindings = <&kp LC(RIGHT)>; };
      desk_next3 { sequence = <D L>; bindings = <&kp LC(RIGHT)>; };
      desk_prev { sequence = <D P>; bindings = <&kp LC(LEFT)>; };
      desk_prev2 { sequence = <D S>; bindings = <&kp LC(LEFT)>; };
      desk_prev3 { sequence = <D H>; bindings = <&kp LC(LEFT)>; };
      
      // shortcut (s)
      shortcut_screenshot_sel { sequence = <S S>; bindings = <&kp LG(LS(N1))>; };
      shortcut_screenshot_win { sequence = <S W>; bindings = <&kp LG(LS(N2))>; };
      
    };
	  alt_tab: alt_tab {
      compatible = "zmk,behavior-tri-state";
      label = "ALT-TAB";
      #binding-cells = <0>;
      bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
      ignored-key-positions = <59 60>;
      timeout-ms = <9000>;
    };
	  cmd_tab: cmd_tab {
      compatible = "zmk,behavior-tri-state";
      label = "CMD-TAB";
      #binding-cells = <0>;
      bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
      ignored-key-positions = <59 60>;
      timeout-ms = <9000>;
    };
  };
};

/ {
	keymap {
		compatible = "zmk,keymap";
		layer_0 { // base-mac
			bindings = <
//╭──────────────────────────────────────────────────────────────────────────────╮
  &bootloader
//│ BOOTLOADER                                                                   │
//├────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┐      ╭────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┬────────────────────┐
   &kp ESC              &kp N1               &kp N2               &kp N3               &kp N4               &kp N5               &leader                     &key_repeat          &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &kp MINUS
//│      [1] ESC       │       [2] 1        │       [3] 2        │       [4] 3        │       [5] 4        │       [6] 5        │     [7] LEADER     │      │     [8] REPEAT     │       [9] 6        │       [10] 7       │       [11] 8       │       [12] 9       │       [13] 0       │     [14] MINUS     │
//├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤      ├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤
   &kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                &kp GRAVE                   &kp EQUAL            &kp Y                &kp U                &kp I                &kp O                &kp P                &kp BSLH
//│      [15] TAB      │       [16] Q       │       [17] W       │       [18] E       │       [19] R       │       [20] T       │     [21] GRAVE     │      │     [22] EQUAL     │       [23] Y       │       [24] U       │       [25] I       │       [26] O       │       [27] P       │     [28] BSLH      │
//├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤                    │      │                    ├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤
   &none                &kp A                &kp S                &kp D                &kp F                &kp G                                                                 &kp H                &kp J                &kp K                &kp L                &kp SEMI             &kp SQT
//│       [29] ·       │       [30] A       │       [31] S       │       [32] D       │       [33] F       │       [34] G       │                    │      │                    │       [35] H       │       [36] J       │       [37] K       │       [38] L       │     [39] SEMI      │      [40] SQT      │
//├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤      ├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤
   &none                &kp Z                &kp X                &kp C                &kp V                &kp B                &kp LBKT                    &kp RBKT             &kp N                &kp M                &kp COMMA            &kp DOT              &kp FSLH             &none
//│       [41] ·       │       [42] Z       │       [43] X       │       [44] C       │       [45] V       │       [46] B       │     [47] LBKT      │      │     [48] RBKT      │       [49] N       │       [50] M       │     [51] COMMA     │      [52] DOT      │     [53] FSLH      │       [54] ·       │
//├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤────────────────────┼────────────────────┤      ├────────────────────┼────────────────────┼────────────────────┼────────────────────┼────────────────────┤────────────────────┤────────────────────┤
   &kp LC(LG(SPACE))    &none                &none                &cmd_tab             &kp LSHFT                                                                                                       &kp RSHFT            &key_repeat          &none                &none                &none
//│     [55] emoji     │       [56] ·       │       [57] ·       │    [58] CMD+TAB    │       [59] ⇧       │                                                                                          │       [60] ⇧       │    [61] REPEAT     │       [62] ·       │       [63] ·       │       [64] ·       │
//╰────────────────────┴────────────────────┴────────────────────┴────────────────────┴────────────────────╯                                                                                          ╰────────────────────┴────────────────────┴────────────────────┴────────────────────┴────────────────────╯
//                                                                                                         ╭────────────────────┬────────────────────╮      ╭────────────────────┬────────────────────╮
                                                                                                            &leader              &mt LC(LG(Q)) C_PP          &to L_LAYERS         &key_repeat
//                                                                                                         │    [65] LEADER     │    [66] LOCK/PP    │      │    [67] TO LYR     │    [68] REPEAT     │
//                                                                                    ╭────────────────────┼────────────────────┼────────────────────┤      ├────────────────────┼────────────────────┼────────────────────╮
                                                                                       &tlt L_EXT_NAV BSPC  &kp LCMD             &kp C_VOL_UP                &kp LC(LEFT)         &tmt RCMD RET        &tlt L_EXT_NUM SPACE
//                                                                                    │   [69] NAV/BSPC    │       [70] ⌘       │     [71] vol+      │      │   [72] PREV DSK    │    [73] CMD/RET    │    [74] NUM/SPC    │
//                                                                                    │                    │                    ├────────────────────┤      ├────────────────────┤                    │                    │
                                                                                                                                 &kp C_VOL_DN                &kp LC(RIGHT)
//                                                                                    │                    │                    │     [75] vol-      │      │   [76] NEXT DSK    │                    │                    │
//                                                                                    ╰────────────────────┴────────────────────┴────────────────────╯      ╰────────────────────┴────────────────────┴────────────────────╯
			>;
		};
		layer_1 { // base-fortnite
			bindings = <
//╭──────────────────────────────────────────────────────────────────────────────╮
  &bootloader
//│ BOOTLOADER                                                                   │
//├──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐      ╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
   &kp ESC        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &none                 &kp C_PP       &trans         &trans         &trans         &trans         &trans         &kp F11
//│   [1] ESC    │    [2] 1     │    [3] 2     │    [4] 3     │    [5] 4     │    [6] 5     │    [7] ·     │      │    [8] ⏯     │    [9] ▽     │    [10] ▽    │    [11] ▽    │    [12] ▽    │    [13] ▽    │   [14] F11   │
//├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤      ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
   &kp J          &kp Z          &kp W          &kp X          &kp R          &kp I          &kp U                 &kp C_VOL_UP   &trans         &trans         &trans         &trans         &trans         &trans
//│    [15] J    │    [16] Z    │    [17] W    │    [18] X    │    [19] R    │    [20] I    │    [21] U    │      │  [22] vol+   │    [23] ▽    │    [24] ▽    │    [25] ▽    │    [26] ▽    │    [27] ▽    │    [28] ▽    │
//├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤              │      │              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
   &kp LCTRL      &kp A          &kp S          &kp D          &kp N5         &kp H                                               &trans         &kp J          &kp K          &kp L          &kp SEMI       &trans
//│    [29] ⌃    │    [30] A    │    [31] S    │    [32] D    │    [33] 5    │    [34] H    │              │      │              │    [35] ▽    │    [36] J    │    [37] K    │    [38] L    │  [39] SEMI   │    [40] ▽    │
//├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤      ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
   &kp LSHFT      &kp N1         &kp N2         &kp N3         &kp N4         &kp N1         &kp F                 &kp C_VOL_DN   &trans         &trans         &trans         &trans         &trans         &trans
//│    [41] ⇧    │    [42] 1    │    [43] 2    │    [44] 3    │    [45] 4    │    [46] 1    │    [47] F    │      │  [48] vol-   │    [49] ▽    │    [50] ▽    │    [51] ▽    │    [52] ▽    │    [53] ▽    │    [54] ▽    │
